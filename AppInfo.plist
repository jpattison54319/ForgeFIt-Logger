<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opt in to the display's adaptive ProMotion range. SwiftUI still lets
	     iOS choose the actual refresh rate for power, thermals, and content. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- No encryption beyond what iOS itself provides (HTTPS/CloudKit), so the
	     export-compliance question is answered here instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- LaunchBackground is deliberately a single dark value with no light
	     variant. The launch screen follows the SYSTEM appearance, but the app
	     pins its own scheme (ThemeManager defaults to dark), so a light variant
	     made every cold launch on a light-mode phone flash near-white before
	     snapping to the dark UI. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>AnvilFMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>ForgeFit reads workout, heart, sleep, and recovery data to summarize training and readiness.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>ForgeFit writes completed workouts to Apple Health when you finish a session.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ForgeFit uses location during outdoor cardio workouts to save route maps and splits on this device.</string>
	<!-- Retained while FeatureFlags.bluetoothHeartRate is off: the string is a
	     declaration, not a prompt, and removing it would crash CBCentralManager
	     init the moment the flag is turned back on. See BLEHeartRateService. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>ForgeFit connects to heart rate monitors — like a Garmin watch broadcasting heart rate, or a chest strap — to show live heart rate during workouts.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>ForgeFit saves workout, routine, and training-cycle images to your photo library when you share them.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!-- audio: spoken cardio cues (split announcements, pace-band and
		     HR-zone guards) while the athlete is on the Home Screen or has
		     pocketed the phone mid-session. The session is only ever active
		     around an utterance (see AudioCueSession) — never a silent
		     keep-alive. -->
		<string>audio</string>
		<string>location</string>
		<string>remote-notification</string>
		<!-- fetch: the pre-dawn BGAppRefreshTask that recomputes readiness
		     from overnight HealthKit data before the 7 AM notification. -->
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.xpetsllc.ForgeFit.readiness-refresh</string>
	</array>
	<!-- Files-app visibility for the sanitized training-log backup
	     (iCloud Drive → ForgeFit). Note: iCloud re-reads this dictionary
	     only on a CFBundleVersion bump. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.org.xpetsllc.ForgeFit</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>ForgeFit</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xpetsllc.ForgeFit.backup</string>
			<key>UTTypeDescription</key>
			<string>ForgeFit Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>forgefitbackup</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.xpetsllc.ForgeFit.plan</string>
			<key>UTTypeDescription</key>
			<string>ForgeFit Plan</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>forgefitplan</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.xpetsllc.forgefit-plan</string>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ForgeFit Plan</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.xpetsllc.ForgeFit.plan</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.xpetsllc.ForgeFit</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>forgefit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
